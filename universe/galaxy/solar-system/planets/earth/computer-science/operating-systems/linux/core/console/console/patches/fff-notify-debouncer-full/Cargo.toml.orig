[package]
name = "fff-notify-debouncer-full"
version = "0.9.4"
description = "notify event debouncer optimized for ease of use"
documentation = "https://docs.rs/notify-debouncer-full"
authors = ["Daniel Faust <hessijames@gmail.com>"]
keywords = ["events", "filesystem", "notify", "watch"]
license = "MIT OR Apache-2.0"
readme = "README.md"
rust-version.workspace = true
edition.workspace = true
homepage.workspace = true
repository.workspace = true

[features]
default = ["macos_fsevent"]
serde = ["notify-types/serde"]
web-time = ["notify-types/web-time"]
crossbeam-channel = ["dep:crossbeam-channel", "notify/crossbeam-channel"]
flume = ["dep:flume", "notify/flume"]
macos_fsevent = ["notify/macos_fsevent"]
macos_kqueue = ["notify/macos_kqueue"]
serialization-compat-6 = ["notify/serialization-compat-6"]
tokio = ["dep:tokio"]
futures = ["dep:futures"]

[dependencies]
# Intentionally NOT using `notify.workspace = true` — this crate is
# published independently via a `[patch.crates-io]` entry in the fff.nvim
# workspace, which pins `notify = 9.0.0-rc.3` from crates.io. Using the
# workspace (path-local, 9.0.0-rc.2) here would give us a different
# `notify` crate than fff.nvim, and the `Watcher` trait impls wouldn't
# unify at the patch boundary.
notify = "9.0.0-rc.4"
notify-types = "2.1.0"
crossbeam-channel = { workspace = true, optional = true }
flume = { workspace = true, optional = true }
futures = { workspace = true, optional = true }
tokio = { workspace = true, optional = true }
file-id.workspace = true
walkdir.workspace = true
log.workspace = true
rustc-hash = "2.1.2"

[dev-dependencies]
pretty_assertions.workspace = true
rstest.workspace = true
serde.workspace = true
deser-hjson.workspace = true
rand.workspace = true
tempfile.workspace = true
tokio = { workspace = true, default-features = true, features = ["time", "rt", "macros"] }
